# Variables del servicio de participación. Este archivo solo lista nombres y ejemplos NO secretos.
# Con la demo de app/ no hace falta: docker compose las arma desde app/.env (generado por preparar-entorno.mjs).
PORT=3003
# Base de datos propia del servicio (PostgreSQL)
DATABASE_URL=
# Servicio de identidad: dirección y credencial de participación (la misma que figura en SERVICE_KEYS de identidad)
IDENTIDAD_URL=http://127.0.0.1:3001
IDENTIDAD_SERVICE_KEY=
# Servicio de programación: dirección; la credencial es IDENTIDAD_SERVICE_KEY (programación la acepta como participacion)
PROGRAMACION_URL=http://127.0.0.1:3002
# Credenciales de los servicios que consultan la API interna (programación), formato nombre:clave
SERVICE_KEYS=
# Clave para derivar el QR y el código de cada entrada (32 bytes aleatorios, nunca en Git)
TICKET_KEY=
ALLOWED_ORIGINS=http://localhost:8080
# Simulador de pago de prueba: on solo en demo o pruebas. Se ignora con NODE_ENV=production
PAYMENT_SIMULATOR=
# Reloj fijo para pruebas o demo (ISO con zona). Se ignora con NODE_ENV=production
CLOCK_FIXED=
# Dirección pública del sitio: la lleva el QR impreso del Pasaporte (spec 006). Depende del dominio (P-12)
PUBLIC_BASE_URL=http://localhost:8080
