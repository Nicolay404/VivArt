# Variables del servicio de programación. Este archivo solo lista nombres y ejemplos NO secretos.
# Con la demo de app/ no hace falta: docker compose las arma desde app/.env (generado por preparar-entorno.mjs).
PORT=3002
# Base de datos propia del servicio (PostgreSQL)
DATABASE_URL=
# Servicio de identidad: dirección y credencial de servicio de programación (la misma que figura en SERVICE_KEYS de identidad)
IDENTIDAD_URL=http://127.0.0.1:3001
IDENTIDAD_SERVICE_KEY=
# Servicio de participación (spec 05). Vacío: el conteo de entradas se informa como «no disponible»
PARTICIPACION_URL=
# Credenciales de los servicios que consultan la API interna, formato nombre:clave separados por coma
SERVICE_KEYS=
ALLOWED_ORIGINS=http://localhost:8080
# Reloj fijo para pruebas o demo (ISO con zona, p. ej. 2026-11-21T19:30:00-05:00). Se ignora con NODE_ENV=production
CLOCK_FIXED=
