# Variables del servicio de identidad. Este archivo solo lista nombres y ejemplos NO secretos.
# Copia a .env (ignorado por Git) y completa los valores reales en tu equipo. No subas secretos.
PORT=3001
DB_FILE=./data/identidad.sqlite
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
# test = buzón de pruebas en memoria (demo y pruebas); console = imprime el enlace (procedimiento interno)
MAIL_TRANSPORT=test
# Credenciales de servicio por consumidor, formato nombre:clave separados por coma. Define claves propias; no se versionan.
SERVICE_KEYS=
SESSION_TTL_HOURS=168
VERIFY_TTL_HOURS=24
RESET_TTL_HOURS=1
ACTIVATE_TTL_HOURS=72
PENDING_TTL_HOURS=24
